{
  "manifest_version": 3,
  "name": "YouTube Recorder",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "在 YouTube 播放页录制播放器区域画面与音频，优先输出 MP4（浏览器/系统不支持时回退 WebM）到本地。通过扩展图标弹窗控制开始与保存，录制仅由用户手动点击触发，绝无后台静默捕获。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabCapture",
    "downloads",
    "activeTab",
    "offscreen",
    "storage",
    "notifications"
  ],
  "action": {
    "default_title": "YouTube Recorder（开始 / 停止录制）",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": [
        "shared/hotkey.js",
        "shared/indicator.js",
        "content/guard.js",
        "content/pip.js",
        "content/selector.js",
        "content/countdown.js",
        "content/content.js",
        "content/hotkey.js"
      ],
      "css": [],
      "run_at": "document_idle"
    }
  ]
}
